{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only: no Worker script. Deploy with `npm run deploy` from site/.
  "name": "aipath",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "aipath.sjapathway.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
